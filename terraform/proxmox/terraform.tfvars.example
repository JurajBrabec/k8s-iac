endpoint            = "https://pve.lab.example:8006/"
insecure            = false
proxmox_node        = "pve"
datastore           = "local-lvm"
image_datastore     = "local"
cpu_type            = "x86-64-v2-AES"
cpu_cores           = 4
memory_gib          = 8
disk_gb             = 40
worker_count        = 2
bridge              = "vmbr0"
gateway             = "192.168.50.1"
dns_server          = "192.168.50.1"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
nodes = {
  lab-server  = { id = 301, address = "192.168.50.101/24" }
  lab-worker1 = { id = 302, address = "192.168.50.102/24" }
  lab-worker2 = { id = 303, address = "192.168.50.103/24" }
  lab-worker3 = { id = 304, address = "192.168.50.104/24" }
}
